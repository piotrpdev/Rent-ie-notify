# Copy to /etc/rent-ie-notify.env, fill in, and restrict it:
#   sudo install -m 600 -o root -g root rent-ie-notify.env.example /etc/rent-ie-notify.env
# systemd reads this file as root before dropping privileges, so the service
# user doesn't need read access. Never commit real values.

# Required: Slack incoming webhook (secret).
SLACK_WEBHOOK_URL='https://hooks.slack.com/services/xxx/xxx/xxxxxx'

# At least one source. Blank or commented-out sources are skipped.
RENT_IE_URL='https://www.rent.ie/rooms-to-rent/xxxx/xxxx/room-type_either/sort-by_date-entered_down/'
# DAFT_IE_REQUEST='{"section":"xxxx","filters":[{"name":"adState","values":["published"]}],"andFilters":[],"ranges":[{"from":"xxxx","to":"xxxx","name":"numBeds"},{"from":"xxxx","to":"xxxx","name":"rentalPrice"}],"paging":{"from":"0","pageSize":"50"},"geoFilter":{"storedShapeIds":["xxxx"],"geoSearchType":"STORED_SHAPES"},"terms":""}'
# PROPERTY_IE_URL='https://www.property.ie/property-to-let/xxxx/price_0-xxxx/beds_xxxx/'

# Optional global client-side bedroom cap.
# MAX_BEDS='5'
# Optional JSON array of named places for distance lines.
# PLACES_OF_INTEREST='[{"name":"Work","latitude":xxxx,"longitude":xxxx}]'
# Optional OpenRouteService API key for driving times/distances (secret).
# OPENROUTESERVICE_API_KEY='xxxx'
# Optional directory for timestamped grouped text reports.
# TEXT_REPORT_DIR='reports'
# Set to 1 to include every unique listing in each report instead of only new ones.
# TEXT_REPORT_INCLUDE_ALL='1'
