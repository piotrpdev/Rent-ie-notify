[Unit]
Description=Checks for new Rent.ie, Daft.ie, and Property.ie listings and posts them to a Slack webhook.
After=network-online.target
Wants=network-online.target

[Service]
# Started hourly by check_rent_ie.timer. A failed run is not restarted: the
# next timer run retries, instead of hammering Cloudflare-protected sites.
Type=oneshot
User=piotrpdev
Group=piotrpdev
WorkingDirectory=/home/piotrpdev/Rent-ie-notify/
ExecStart=/home/piotrpdev/Rent-ie-notify/target/release/Rent-ie-notify
# Safety net in case a request or pagination loop hangs.
TimeoutStartSec=30min
# Configuration and secrets (Slack webhook, rent.ie URL, ORS key) live in a
# root-owned 0600 file instead of this world-readable unit; see
# rent-ie-notify.env.example.
EnvironmentFile=/etc/rent-ie-notify.env
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
