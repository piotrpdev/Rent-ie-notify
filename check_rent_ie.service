[Unit]
Description=Checks for new Rent.ie, Daft.ie, and Property.ie listings and posts them to a Slack webhook.
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Type=simple
User=piotrpdev
Group=piotrpdev
WorkingDirectory=/home/piotrpdev/Rent-ie-notify/ 
ExecStart=/home/piotrpdev/Rent-ie-notify/target/release/Rent-ie-notify
Restart=on-failure
RestartSec=5s
Environment=RENT_IE_URL='https://www.rent.ie/rooms-to-rent/xxxx/xxxx/room-type_either/sort-by_date-entered_down/'
# Optional daft.ie source: JSON request body for gateway.daft.ie.
Environment=DAFT_IE_REQUEST='{"section":"xxxx","filters":[{"name":"adState","values":["published"]}],"andFilters":[],"ranges":[{"from":"xxxx","to":"xxxx","name":"numBeds"},{"from":"xxxx","to":"xxxx","name":"rentalPrice"}],"paging":{"from":"0","pageSize":"200"},"geoFilter":{"storedShapeIds":["xxxx"],"geoSearchType":"STORED_SHAPES"},"terms":""}'
# Optional property.ie source.
# Environment=PROPERTY_IE_URL='https://www.property.ie/property-to-let/xxxx/price_0-xxxx/beds_xxxx/'
# Optional global client-side bedroom cap.
# Environment=MAX_BEDS='5'
# Optional: JSON array of named places for distance lines.
# Environment=PLACES_OF_INTEREST='[{"name":"Work","latitude":xxxx,"longitude":xxxx}]'
# Optional: OpenRouteService API key for driving times/distances.
# Environment=OPENROUTESERVICE_API_KEY='xxxx'
# Optional: write timestamped grouped text reports to this directory.
# Environment=TEXT_REPORT_DIR='reports'
# Set to 1 to include every unique listing in each report instead of only new ones.
# Environment=TEXT_REPORT_INCLUDE_ALL='1'
Environment=SLACK_WEBHOOK_URL='https://hooks.slack.com/services/xxx/xxx/xxxxxx'

[Install]
WantedBy=multi-user.target